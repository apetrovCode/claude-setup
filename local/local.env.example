# Copy to ~/.claude/local/local.env and fill in. Sourced by install.sh and by
# claude/bin/gh-mcp-headers.sh. Shell syntax, no export needed.
#
# Keep credentials OUT of this file. Every value here is a name or a path.

# GitHub account the `github` MCP server authenticates as. Pin it whenever more
# than one account is logged in to gh, otherwise `gh auth switch` silently
# changes which org the server can see. Leave unset to use the active account.
GH_MCP_ACCOUNT=

# GitHub host, for GitHub Enterprise. Defaults to github.com.
#GH_MCP_HOST=github.com

# Where repos get cloned. Written into jira-defaults.json.
GITS_DIR="$HOME/gits"

# Default Jira project key.
JIRA_PROJECT_KEY=

# Settings profile to build: default | bedrock
CLAUDE_PROFILE=default

# Only read by the bedrock profile: the AWS profile name to route through.
#BEDROCK_AWS_PROFILE=

# Default region exported into the Claude environment.
#AWS_REGION=us-east-1
